<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A74DA"
    android:padding="24dp">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>

    <!-- Digital Clock -->
    <TextView
        android:id="@+id/clockText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="13:50"
        android:textSize="80sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"/>

    <!-- Greeting with Company Name and Date -->
    <LinearLayout
        android:id="@+id/dateContainer"

        android:layout_below="@id/clockText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/greetingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to [Company Name]"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"/>

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tuesday, June 20"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Pin dots container (programmatic) -->
    <LinearLayout
        android:id="@+id/pinDots"
        android:layout_below="@id/dateContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/pin_dot"/>
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/pin_dot"/>
        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/pin_dot"/>
    </LinearLayout>

    <!-- Prompt text -->
    <TextView
        android:id="@+id/promptText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please enter Employee ID"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:layout_below="@id/pinDots"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"/>

    <!-- Number pad -->
    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/promptText"
        android:layout_above="@id/Icons"
        android:layout_marginTop="24dp"
        android:layout_centerHorizontal="true"
        android:rowCount="4"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        android:gravity="center">

        <Button android:text="1" style="@style/KeyButton" />
        <Button android:text="2" style="@style/KeyButton" />
        <Button android:text="3" style="@style/KeyButton" />
        <Button android:text="4" style="@style/KeyButton" />
        <Button android:text="5" style="@style/KeyButton" />
        <Button android:text="6" style="@style/KeyButton" />
        <Button android:text="7" style="@style/KeyButton" />
        <Button android:text="8" style="@style/KeyButton" />
        <Button android:text="9" style="@style/KeyButton" />
        <Button android:text="⌫" style="@style/KeyButton" />
        <Button android:text="0" style="@style/KeyButton" />
        <Button android:text="x" style="@style/KeyButton" />

    </GridLayout>

    <!-- Face ID, NFC, Settings Icons -->
    <LinearLayout
        android:id="@+id/Icons"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">>

        <ImageView
            android:id="@+id/cameraIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_camera"
            android:layout_marginEnd="24dp" />

        <ImageView
            android:id="@+id/nfcIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_nfc"
            android:layout_marginEnd="24dp"
            android:contentDescription="NFC" />

        <ImageView
            android:id="@+id/settingsIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings" />

    </LinearLayout>

    <!-- Clock In / Out Buttons -->

</RelativeLayout>
