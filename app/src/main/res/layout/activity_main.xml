<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A74DA"
    android:padding="24dp">

    <!-- Digital Clock -->
    <TextView
        android:id="@+id/clockText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="13:50"
        android:textSize="80sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"/>

    <!-- Greeting with Company Name and Date -->
    <LinearLayout
        android:id="@+id/dateContainer"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/clockText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/greetingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to [Company Name]"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_gravity="center"/>

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tuesday, June 20"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center"/>
    </LinearLayout>

    <!-- Pin dots -->
    <LinearLayout
        android:id="@+id/pinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/dateContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/pin_dot"/>
        <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/pin_dot" android:layout_marginStart="10dp"/>
        <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/pin_dot" android:layout_marginStart="10dp"/>
        <View android:layout_width="24dp" android:layout_height="24dp" android:background="@drawable/pin_dot" android:layout_marginStart="10dp"/>
    </LinearLayout>

    <!-- Number pad -->
    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/pinDots"
        android:layout_above="@id/Icons"
        android:layout_margin="80dp"
        android:layout_centerHorizontal="true"
        android:rowCount="4"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        android:gravity="center">


        <Button android:text="1" style="@style/KeyButton"/>
        <Button android:text="2" style="@style/KeyButton"/>
        <Button android:text="3" style="@style/KeyButton"/>
        <Button android:text="4" style="@style/KeyButton"/>
        <Button android:text="5" style="@style/KeyButton"/>
        <Button android:text="6" style="@style/KeyButton"/>
        <Button android:text="7" style="@style/KeyButton"/>
        <Button android:text="8" style="@style/KeyButton"/>
        <Button android:text="9" style="@style/KeyButton"/>
        <Button android:text="⌫" style="@style/KeyButton"/>
        <Button android:text="0" style="@style/KeyButton"/>
        <Button android:text="x" style="@style/KeyButton"/>
    </GridLayout>

    <!-- Face ID, NFC, Settings Icons -->
    <LinearLayout
        android:id="@+id/Icons"
        android:layout_above="@id/clockInOut"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="120dp"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/cameraIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/ic_menu_camera"
            android:layout_marginEnd="24dp"/>

        <ImageView
            android:id="@+id/nfcIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_nfc"
            android:layout_marginEnd="24dp"
            android:contentDescription="NFC"/>

        <ImageView
            android:id="@+id/settingsIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Clock In / Out Buttons -->
    <LinearLayout
        android:id="@+id/clockInOut"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="40dp"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/clockOutButton"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:text="Out"
            android:textSize="18sp"
            android:backgroundTint="#CCCCCC"/>

        <Button
            android:id="@+id/clockInButton"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:text="In"
            android:textSize="18sp"
            android:layout_marginStart="20dp"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>
</RelativeLayout>
