<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#FFFFFF" />

    <!-- Make corners very rounded -->
    <corners android:radius="64dp" />  <!-- Try 100dp if you want full pill-like rounding -->

    <!-- Optional: padding inside background -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
